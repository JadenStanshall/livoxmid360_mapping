Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Color: 160; 160; 164
      Alpha: 0.5
      Plane: XY
      Plane Cell Count: 20
    - Alpha: 0.8
      Class: rviz_default_plugins/PointCloud2
      Color: 200; 200; 200
      Color Transformer: FlatColor
      Enabled: false
      Name: Prior Map
      Size (m): 0.02
      Style: Points
      Topic:
        Value: /overall_map
        Depth: 1
        Reliability Policy: Reliable
    - Alpha: 0.6
      Class: rviz_default_plugins/PointCloud2
      Color: 100; 255; 100
      Color Transformer: FlatColor
      Enabled: true
      Name: Local Map
      Size (m): 0.02
      Style: Points
      Topic:
        Value: /laser_cloud_map
        Depth: 1
        Reliability Policy: Reliable
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 0; 200; 255
      Color Transformer: FlatColor
      Enabled: true
      Name: Live Scan
      Size (m): 0.03
      Style: Points
      Topic:
        Value: /registered_scan
        Depth: 5
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Enabled: false
      Keep: 500
      Name: Localization Pose (arrows)
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Topic:
        Value: /laser_odometry
        Depth: 5
        Reliability Policy: Reliable
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 140; 0
      Enabled: true
      Head Diameter: 0.0
      Head Length: 0.0
      Length: 0.0
      Line Style: Billboards
      Line Width: 0.1
      Name: Path Trail
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.0
      Shaft Length: 0.0
      Topic:
        Value: /robot_path
        Depth: 5
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Robot Body
      Topic:
        Value: /robot_marker
        Depth: 5
        Reliability Policy: Reliable
  Enabled: true
  Fixed Frame: map
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.5707
      Target Frame: map
      Yaw: 0
    Saved: ~
Window Geometry:
  Height: 850
  Width: 1400
  X: 80
  Y: 80
