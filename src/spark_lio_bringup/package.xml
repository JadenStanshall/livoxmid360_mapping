<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spark_lio_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files, configs, and RViz2 layouts for the spark-fast-lio + KISS-Matcher-SAM
    mapping pipeline and SuperOdom localization pipeline.
  </description>
  <maintainer email="jaden.uoft@gmail.com">Jaden</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>kiss_matcher_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
