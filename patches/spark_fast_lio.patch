+  // Ground vehicle constraints: this robot moves only in the XY plane on a flat floor.
+  // Enforcing zero Z velocity, fixed Z position, and zero roll/pitch prevents IMU Z-axis
+  // bias, noisy horizontal plane scan matching, and gyro drift from smearing the map in Z.
+  {
+    auto x_clamped = kf_.get_x();
+
+    // 1. Latch Z position on the first post-init scan; hold it fixed thereafter.
+    //    Prevents IEKF ceiling/floor correspondences from oscillating pos[2] scan-to-scan.
+    if (!ground_z_set_) {
+      ground_z_pos_ = x_clamped.pos[2];
+      ground_z_set_ = true;
+    }
+    x_clamped.pos[2] = ground_z_pos_;
+
+    // 2. Zero Z velocity
+    x_clamped.vel[2] = 0.0;
+
+    // 3. Force rotation to pure yaw — extract yaw from current rotation matrix,
+    //    then reconstruct with roll=0, pitch=0.
+    const Eigen::Matrix3d R = x_clamped.rot.toRotationMatrix();
+    const double yaw        = std::atan2(R(1, 0), R(0, 0));
+    x_clamped.rot = SO3(Eigen::Quaterniond(Eigen::AngleAxisd(yaw, Eigen::Vector3d::UnitZ())));
+
+    kf_.change_x(x_clamped);
